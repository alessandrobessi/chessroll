{
  "name": "chessroll",
  "version": "0.0.0",
  "private": true,
  "description": "Turn PGN/FEN chess content into deterministic 1080x1920 short-form videos.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.26.1",
  "bin": {
    "chessroll": "./dist/cli.js",
    "chessroll-debug": "./dist/debug-cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "execa": "^10.0.1",
    "picocolors": "^1.1.1",
    "playwright": "^1.62.1",
    "which": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/which": "^3.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
